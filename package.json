{
  "name": "local-video-library",
  "version": "1.1.0",
  "description": "影库 — Windows 本地视频整理器",
  "main": "electron/main.cjs",
  "author": "Local Video Library contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "playwright test",
    "dist:win": "node scripts/prepare-notices.cjs && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "fuse.js": "7.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.localvideolibrary",
    "productName": "影库",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "Yingku-${version}-Windows-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "third-party",
        "to": "third-party"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
